---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import Home from '../features/home/Home.astro';
import { OwlMascot } from '../features/mascot/react/OwlMascot';
---

<BaseLayout
  title="Luis Pazos · Desarrollador Full Stack"
  description="Portfolio de Luis Pazos, desarrollador Full Stack: webs y aplicaciones con identidad pixel art."
>
  <SiteHeader />

  <main id="inicio">
    <Home>
      <OwlMascot
        slot="mascot"
        client:visible
        baseUrl="/buho"
        background="night"
        height="clamp(4.5rem,10vw,8rem)"
      />
    </Home>
  </main>

  <SiteFooter />
</BaseLayout>
