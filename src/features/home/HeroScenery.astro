---
// Escena de cierre de la portada: paisaje, búho y ruta punteada, como en la captura de referencia.
---

<div class="relative select-none lg:mt-0">
  <img
    src="/images/paisaje-inferior.webp"
    alt=""
    width="1536"
    height="240"
    class="pixel-image block h-[clamp(7rem,16vw,13rem)] w-full object-cover"
  />

  <img
    src="/images/buho.webp"
    alt="Búho pixel art mirando a la ruta"
    width="160"
    height="160"
    class="pixel-image absolute -bottom-1 left-2 z-10 h-[clamp(4rem,9vw,8rem)] w-auto"
  />

  <svg
    class="pointer-events-none absolute inset-x-0 bottom-6 hidden h-16 w-full text-accent-pink sm:block"
    viewBox="0 0 1200 80"
    fill="none"
    aria-hidden="true"
    preserveAspectRatio="none"
  >
    <path
      d="M120 62 C 320 18, 520 70, 720 40 S 1040 58, 1140 44"
      stroke="currentColor"
      stroke-width="3"
      stroke-dasharray="10 10"
      stroke-linecap="round"
    ></path>
  </svg>

  <a
    href="#proyectos"
    class="absolute right-6 bottom-6 hidden size-11 items-center justify-center rounded-full border-2 border-accent-purple text-accent-purple no-underline hover:border-accent-cyan hover:text-accent-cyan focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-cyan sm:flex"
  >
    <img src="/svg/icons/arrow-down.svg" alt="Bajar a proyectos" width="18" height="18" />
  </a>
</div>
